{
  "name": "rsi",
  "version": "0.0.0",
  "private": true,
  "description": "Public Recursive Self-Improvement project for supervised market research and bounded action.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-james-bridges/rsi.git"
  },
  "homepage": "https://github.com/tyler-james-bridges/rsi#readme",
  "bugs": {
    "url": "https://github.com/tyler-james-bridges/rsi/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "ci:actions": "node scripts/ci/verify-actions-pinned.mjs",
    "ci:clean": "node scripts/ci/verify-clean.mjs",
    "ci:contract": "node scripts/ci/verify-production-contract.mjs",
    "ci:demos": "node scripts/ci/run-offline-demos.mjs",
    "ci:drills": "node scripts/ci/run-offline-safety-drills.mjs",
    "ci:opensea": "node scripts/ci/verify-opensea-read-canary-boundary.mjs && node --test scripts/ci/verify-opensea-read-canary-boundary.test.mjs",
    "ci:release": "node scripts/ci/verify-release-inventory-reproducible.mjs",
    "ci:runtime": "node scripts/ci/assert-runtime.mjs",
    "ci:secrets": "node scripts/ci/secret-scan.mjs",
    "ci:stage0": "node scripts/ci/verify-stage0-authority-boundary.mjs && node --test scripts/ci/verify-stage0-authority-boundary.test.mjs",
    "ci:stage1": "node scripts/ci/verify-stage1-read-canary-boundary.mjs && node --test scripts/ci/verify-stage1-read-canary-boundary.test.mjs",
    "demo": "pnpm --filter @rsi/cli start",
    "demo:ingestion": "pnpm --filter @rsi/cli ingestion",
    "demo:pipeline": "pnpm --filter @rsi/cli pipeline",
    "operator": "pnpm --filter @rsi/cli run operator --",
    "operator:opensea-canary": "pnpm --filter @rsi/cli run operator:opensea-canary --",
    "operator:x-canary": "pnpm --filter @rsi/cli run operator:x-canary --",
    "operator:demo": "pnpm --filter @rsi/cli run operator --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
