    "@rsi/research": "workspace:*",
    "@rsi/runtime": "workspace:*",
    "@rsi/store": "workspace:*",
    "@rsi/vault": "workspace:*",
    "@rsi/x-collector": "workspace:*",
    "tsx": "^4.23.12"
